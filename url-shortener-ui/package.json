{
  "name": "url-shortener-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "rm -rf .next && next dev",
    "clean": "rm -rf .next",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "NODE_OPTIONS=--no-deprecation vitest",
    "test:run": "NODE_OPTIONS=--no-deprecation vitest run",
    "test:ui": "NODE_OPTIONS=--no-deprecation vitest --ui",
    "test:coverage": "NODE_OPTIONS=--no-deprecation vitest --coverage",
    "test:compiled": "NODE_OPTIONS=--no-deprecation COMPILED_TEST_INCLUDE='src/**/*.test.{ts,tsx}' vitest run -c vitest.compiler.config.ts",
    "check:compiler-bailouts": "node scripts/check-compiler-bailouts.mjs",
    "check:bundle-budgets": "NEXT_PUBLIC_ENABLE_TURNSTILE=false next build && node scripts/check-bundle-budgets.mjs",
    "test:perf": "NODE_OPTIONS=--no-deprecation vitest run -c vitest.compiler.config.ts",
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.5.3",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "culori": "^4.0.2",
    "embla-carousel": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.34.3",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.562.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "qr-code-styling": "^1.9.2",
    "radix-ui": "^1.4.3",
    "react": "^19.2.3",
    "react-colorful": "^5.8.0",
    "react-day-picker": "^9.13.2",
    "react-dom": "^19.2.3",
    "recharts": "^3.9.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "vaul": "^1.1.2",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/canvas-confetti": "^1.9.0",
    "@types/culori": "^4.0.1",
    "@types/node": "^24",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/ui": "^4.1.8",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.10",
    "react-scan": "^0.5.7",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
