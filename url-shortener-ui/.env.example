# Cloudflare Turnstile (CAPTCHA)
# https://developers.cloudflare.com/turnstile
# -----------------------------------------------------------------------------
# Set to false to disable Turnstile entirely (e.g. in local dev or tests)
NEXT_PUBLIC_ENABLE_TURNSTILE=true

# Use the dummy keys below for local development (never commit real keys)
#
# Visible widget:
#   1x00000000000000000000AA  → always passes             (test successful submissions)
#   2x00000000000000000000AB  → always fails              (test error handling & retry)
#   3x00000000000000000000FF  → forces interactive        (test checkbox interaction)
#
# Invisible widget:
#   1x00000000000000000000BB  → always passes             (test silent success flow)
#   2x00000000000000000000BB  → always fails              (test invisible error handling)
#
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Backend base URL, server-only (the /api rewrite, the import-progress route handler and the inspect page).
# NEXT_PUBLIC_API_BASE_URL is still read as a deprecated fallback; rename it, because NEXT_PUBLIC_ values are
# inlined at build time and can end up in browser bundles.
BACKEND_API_BASE_URL=http://localhost:8080

# Security headers (next.config.ts). The Content-Security-Policy is sent in Report-Only mode by default:
# browsers report violations in the console but block nothing. Set to true to enforce it.
CSP_ENFORCE=false
