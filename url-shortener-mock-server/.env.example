# Port the mock server listens on (default: 8080)
PORT=8080

# Artificial delay in milliseconds applied to every response (default: 0)
# Useful for simulating real-world network latency during development
MOCK_DELAY=200

# Randomize analytics click data for every request (default: false)
RANDOM_ANALYTICS_DATA=false

# Interval in minutes between cleanup runs (default: 1440 = 24 hours)
MOCK_CLEANUP_INTERVAL_MINUTES=1440

# Number of days of inactivity before user data is cleaned up (default: 7)
MOCK_CLEANUP_INACTIVITY_DAYS=7
