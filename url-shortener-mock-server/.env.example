# Port the mock server listens on (default: 8080)
PORT=8080

# Artificial delay in milliseconds applied to every response (default: 0)
# Useful for simulating real-world network latency during development
MOCK_DELAY=200

# Randomize analytics click data for every request (default: false)
RANDOM_ANALYTICS_DATA=false

# Frontend URL that the mock server redirects back to after OAuth/OTT flows (default: http://localhost:3000)
FRONTEND_URL=http://localhost:3000

# Enable cooldown for magic-link generation (default: true)
MOCK_COOLDOWN_ENABLED=true

# Cooldown duration in seconds (default: 60)
MOCK_COOLDOWN_SECONDS=60

# Initial billing state for each sandbox user (default: free)
# free, pro-monthly, pro-yearly, pro-pending, pro-canceling, trialing, past-due, canceled, expired
MOCK_BILLING_SCENARIO=free

# Portal expiration payload for TTL testing (default: reported)
# reported, omitted, invalid, expired
MOCK_BILLING_PORTAL_EXPIRY=reported

# Log billing API method, path and status for portal-return debugging (never tokens or session URLs)
MOCK_BILLING_TRACE=false

# Optional externally reachable mock-server origin for billing session links
# MOCK_PUBLIC_URL=http://localhost:8080
